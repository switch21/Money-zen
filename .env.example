# Money-zen — Variables d'environnement
#
# INSTRUCTIONS :
#   1. Copier ce fichier en .env :  cp .env.example .env
#   2. Remplir les valeurs (JAMAIS committer .env dans Git)
#   3. OU lancer :  ./setup-env.sh   (script interactif, plus sûr pour les secrets)
#
# ⚠️  SÉCURITÉ — Ne collez JAMAIS vos clés API dans un chat ou un outil externe.
#     Utilisez setup-env.sh ou remplissez .env localement à la main.

# ═══════════════════════════════════════════════════════════════════════════
# 1. SUPABASE — BACKEND CLOUD (Phase 15) ─ PRIORITÉ HAUTE
# ═══════════════════════════════════════════════════════════════════════════
# Obtention : https://supabase.com → Dashboard → Project Settings → API
#
# URL publique du projet (sans slash final)
EXPO_PUBLIC_SUPABASE_URL=
# Anon public key (clé publique safe d'embarquer dans l'app)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (NE JAMAIS embarquer dans l'app ! À utiliser côté serveur/edge functions uniquement)
# Laisser vide ici — la valeur n'est jamais lue par l'app mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Stratégie de sync : 'auto' | 'manual' | 'disabled' (défaut : auto si URL+KEY renseignés)
EXPO_PUBLIC_SYNC_STRATEGY=auto

# Mode de stockage des reçus : 'local' | 'cloud' | 'hybrid' (défaut : local)
EXPO_PUBLIC_RECEIPT_STORAGE_MODE=local

# ═══════════════════════════════════════════════════════════════════════════
# 2. OCR.space — 4 CLÉS API POUR FAILOVER (Phase 17)
# ═══════════════════════════════════════════════════════════════════════════
# Obtention : https://ocr.space/ocrapi → Sign up (gratuit, pas de CB) → "API Key"
# Crée 4 comptes séparés pour cumuler 4 × 25 000 = 100 000 scans/mois gratuits.
#
EXPO_PUBLIC_OCR_API_KEY_1=
EXPO_PUBLIC_OCR_API_KEY_2=
EXPO_PUBLIC_OCR_API_KEY_3=
EXPO_PUBLIC_OCR_API_KEY_4=
#
# Provider OCR principal (par défaut 'ocrspace')
EXPO_PUBLIC_OCR_PROVIDER=ocrspace
#
# Limite utilisateur (anti-abus) : max scans/user/mois
EXPO_PUBLIC_OCR_USER_MONTHLY_LIMIT=10

# ═══════════════════════════════════════════════════════════════════════════
# 3. TAUX DE CHANGE — MOTEUR MULTIDEVISE (Phase 6)
# ═══════════════════════════════════════════════════════════════════════════
# Provider : frankfurter (gratuit, pas de clé) | openexchangerates | exchangerate.host
EXPO_PUBLIC_EXCHANGE_RATE_PROVIDER=frankfurter
#
# Clé API (uniquement si provider != frankfurter)
EXPO_PUBLIC_EXCHANGE_RATE_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 4. IA INSIGHTS — FUTUR (Phase 17, optionnel V1)
# ═══════════════════════════════════════════════════════════════════════════
# Laisser vide en V1. Sera utilisé quand on branchera un LLM pour analyses avancées.
EXPO_PUBLIC_FINANCIAL_INSIGHTS_API_KEY=
EXPO_PUBLIC_FINANCIAL_INSIGHTS_PROVIDER=

# ═══════════════════════════════════════════════════════════════════════════
# 5. ANALYTICS — OPTIONNEL (désactivé par défaut)
# ═══════════════════════════════════════════════════════════════════════════
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ANALYTICS_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 6. MODE DÉMO — DEV/DEBUG UNIQUEMENT
# ═══════════════════════════════════════════════════════════════════════════
# 'true' active le mode démo au prochain lancement (seeds 4 comptes + 3 mois de transactions)
EXPO_PUBLIC_DEMO_MODE=false
